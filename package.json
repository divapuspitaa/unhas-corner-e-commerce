{
  "name": "unhas-corner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i ./src/app/globals.css -o ./src/app/tailwind.generated.css --minify",
    "css:watch": "tailwindcss -i ./src/app/globals.css -o ./src/app/tailwind.generated.css --watch",
    "dev": "npm run css:build && concurrently -k -n css,next \"npm run css:watch\" \"next dev\"",
    "build": "npm run css:build && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.3"
  }
}
